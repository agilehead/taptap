{
  "name": "@agilehead/taptap",
  "version": "0.0.1",
  "description": "Notification and email delivery service",
  "type": "module",
  "private": true,
  "workspaces": [
    "services/*",
    "services/*/apps/*",
    "services/*/node/packages/*"
  ],
  "scripts": {
    "build": "npm run verify:structure && ./scripts/build.sh --no-format && node services/taptap/csharp/scripts/generate-model.mjs --check && dotnet build TapTap.CSharp.slnx --disable-build-servers -m:1 -p:UseSharedCompilation=false",
    "clean": "./scripts/clean.sh",
    "start": "./services/taptap/scripts/start.sh",
    "test": "node services/taptap/scripts/test-services.mjs && node services/taptap/scripts/test-smtp.mjs",
    "migrate:taptap:latest": "knex migrate:latest --knexfile services/taptap/knexfile.taptap.mjs",
    "migrate:taptap:rollback": "knex migrate:rollback --knexfile services/taptap/knexfile.taptap.mjs",
    "migrate:taptap:status": "knex migrate:status --knexfile services/taptap/knexfile.taptap.mjs",
    "migrate:taptap:make": "knex migrate:make --knexfile services/taptap/knexfile.taptap.mjs",
    "build:native": "node services/taptap/csharp/scripts/publish-native.mjs",
    "lint": "./scripts/lint-all.sh && ./node_modules/.bin/eslint \"services/taptap/**/*.mjs\"",
    "test:contracts": "node services/taptap/scripts/test-services.mjs",
    "format": "./scripts/format-all.sh",
    "generate:model": "node services/taptap/csharp/scripts/generate-model.mjs",
    "test:integration": "./services/taptap/scripts/test-integration.sh compose",
    "test:smtp": "node services/taptap/scripts/test-smtp.mjs",
    "start:nativeaot": "./services/taptap/scripts/start.sh nativeaot",
    "verify:structure": "node scripts/verify-structure.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chai": "^5.0.2",
    "@types/node": "^22.10.5",
    "chai": "^5.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.19.1"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "knex": "^3.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agilehead/taptap.git"
  },
  "keywords": [
    "notifications",
    "email",
    "queue",
    "typescript"
  ],
  "author": "Agilehead",
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.27.2": true
  }
}

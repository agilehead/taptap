# TapTap Environment Configuration
# Copy to .env and update with your values
#
# IMPORTANT: All required variables must be set. No defaults are used.

# =============================================================================
# Server Configuration (REQUIRED)
# =============================================================================
TAPTAP_SERVER_HOST=127.0.0.1
TAPTAP_SERVER_PORT=5006

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================
# Directory containing the existing Knex-migrated taptap.db
TAPTAP_DATA_DIR=./data

# =============================================================================
# Cron Secret (REQUIRED)
# =============================================================================
# Secret for authenticating internal cron endpoints (e.g., /internal/cron/process-queue)
TAPTAP_CRON_SECRET=change-me-to-a-random-secret

# =============================================================================
# CORS Configuration (REQUIRED)
# =============================================================================
# Comma-separated list of allowed origins
TAPTAP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Email Provider Configuration (REQUIRED)
# =============================================================================
# Provider: "console" (logs to stdout) or "smtp" (sends real emails)
TAPTAP_EMAIL_PROVIDER=console

# From address and name for outgoing emails (REQUIRED)
TAPTAP_EMAIL_FROM_ADDRESS=noreply@example.com
TAPTAP_EMAIL_FROM_NAME=My App

# SMTP settings (required when TAPTAP_EMAIL_PROVIDER=smtp)
# TAPTAP_SMTP_HOST=smtp.example.com
# TAPTAP_SMTP_PORT=587
# TAPTAP_SMTP_SECURE=false
# TAPTAP_SMTP_USER=
# TAPTAP_SMTP_PASSWORD=

# =============================================================================
# Queue Configuration (optional, defaults shown)
# =============================================================================
# TAPTAP_QUEUE_BATCH_SIZE=10
# TAPTAP_QUEUE_MAX_ATTEMPTS=3

# =============================================================================
# Logging (optional)
# =============================================================================
LOG_LEVEL=info
# TAPTAP_LOG_FILE_DIR=./data/logs

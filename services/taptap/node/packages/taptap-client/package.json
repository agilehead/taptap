{
  "name": "@agilehead/taptap-client",
  "version": "0.0.2",
  "description": "Client library for the TapTap notification service",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=60000 src/tests/client.test.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:build": "tsc --project src/tests/tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/chai": "^5.2.1",
    "@types/node": "^22.15.2",
    "chai": "^5.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "taptap",
    "notifications",
    "email",
    "client",
    "api"
  ],
  "author": "Agilehead",
  "license": "MIT"
}
